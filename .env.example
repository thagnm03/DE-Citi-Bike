# Local-development defaults only. Do not reuse these credentials in a shared environment.
COMPOSE_PROJECT_NAME=citibike-platform
KAFKA_IMAGE=apache/kafka:4.3.1
SPARK_IMAGE=apache/spark:4.2.0-python3
POSTGRES_IMAGE=postgres:17-alpine
KAFKA_HOST_PORT=9092
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
POSTGRES_HOST_PORT=15432
POSTGRES_DB=citibike
POSTGRES_USER=citibike
POSTGRES_PASSWORD=citibike_local_only
SERVING_API_PORT=18000
KAFKA_TOPIC_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_OBSERVATION_RETENTION_MS=259200000
KAFKA_ALERT_RETENTION_MS=604800000
KAFKA_WINDOW_RETENTION_MS=604800000
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1g
LOG_LEVEL=INFO
GBFS_DISCOVERY_URL=https://gbfs.citibikenyc.com/gbfs/2.3/gbfs.json
GBFS_LANGUAGE=en
GBFS_MIN_POLL_SECONDS=60
GBFS_STALE_AFTER_SECONDS=180
GBFS_METADATA_REFRESH_SECONDS=3600
GBFS_REQUEST_TIMEOUT_SECONDS=20
GBFS_RETRY_ATTEMPTS=4
GBFS_RETRY_BASE_SECONDS=1
GBFS_RETRY_MAX_SECONDS=15
COLLECTOR_ARCHIVE_ROOT=data/raw/gbfs
COLLECTOR_STATE_FILE=data/state/gbfs-collector.json
COLLECTOR_METRICS_FILE=artifacts/step6/metrics.json
