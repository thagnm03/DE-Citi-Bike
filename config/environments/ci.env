# Isolated ports and smaller worker allocation for automated checks.
COMPOSE_PROJECT_NAME=citibike-platform-ci
KAFKA_IMAGE=apache/kafka:4.3.1
SPARK_IMAGE=apache/spark:4.2.0-python3
POSTGRES_IMAGE=postgres:17-alpine
KAFKA_HOST_PORT=19092
SPARK_MASTER_PORT=17077
SPARK_MASTER_UI_PORT=18080
SPARK_WORKER_UI_PORT=18081
POSTGRES_HOST_PORT=25432
POSTGRES_DB=citibike_ci
POSTGRES_USER=citibike_ci
POSTGRES_PASSWORD=citibike_ci_only
SERVING_API_PORT=28000
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
PROMETHEUS_PORT=29090
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=8
DATABASE_POOL_TIMEOUT_SECONDS=5
KAFKA_TOPIC_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_OBSERVATION_RETENTION_MS=86400000
KAFKA_ALERT_RETENTION_MS=86400000
KAFKA_WINDOW_RETENTION_MS=86400000
SPARK_WORKER_CORES=1
SPARK_WORKER_MEMORY=768m
LOG_LEVEL=WARN
GBFS_DISCOVERY_URL=https://gbfs.citibikenyc.com/gbfs/2.3/gbfs.json
GBFS_LANGUAGE=en
GBFS_MIN_POLL_SECONDS=60
GBFS_STALE_AFTER_SECONDS=180
GBFS_METADATA_REFRESH_SECONDS=3600
GBFS_REQUEST_TIMEOUT_SECONDS=10
GBFS_RETRY_ATTEMPTS=3
GBFS_RETRY_BASE_SECONDS=0.1
GBFS_RETRY_MAX_SECONDS=1
COLLECTOR_ARCHIVE_ROOT=data/raw/gbfs
COLLECTOR_STATE_FILE=data/state/gbfs-collector-ci.json
COLLECTOR_METRICS_FILE=artifacts/step6/metrics-ci.json
